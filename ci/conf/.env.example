# 本地部署配置模板
# 复制本文件为 ci/conf/.env 并填写真实值；ci/conf/.env 已被 .gitignore 忽略，不会入库。
# local_deploy.ps1 会读取 ci/conf/.env（若不存在再读项目根 .env），环境变量优先级高于文件。

# JDK 可执行文件；留空则依次尝试 $env:JAVA_HOME/bin/java.exe、PATH 中的 java
JAVA_EXE=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Spring 激活的 profile
SPRING_PROFILES_ACTIVE=dev
